# Copy to .env and replace placeholders. Never commit .env.
SECRET_KEY=replace-with-a-generated-secret-at-least-50-characters-long
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
DB_NAME=santolan_pwd
DB_USER=santolan_app
DB_PASSWORD=replace-with-a-random-database-password
DB_HOST=127.0.0.1
DB_PORT=3307
# Separate, disposable Django test database; never set this to DB_NAME.
DB_TEST_NAME=test_santolan_pwd
# Production HTTPS; leave off only for local HTTP development.
SECURE_SSL_REDIRECT=False
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False
SECURE_HSTS_SECONDS=0
CSRF_TRUSTED_ORIGINS=
# Shared fixed-window limits for all login attempts, including successful ones.
LOGIN_USERNAME_LIMIT=10
LOGIN_ADDRESS_LIMIT=50
LOGIN_WINDOW_SECONDS=900
SESSION_COOKIE_AGE=3600
# Identity verification is required for progress; receipt QR codes open that form.
PROGRAM_TRACKING_ENABLED=True
PROGRAM_TRACKING_QR_ENABLED=True
PROGRAM_TRACKING_GRANT_SECONDS=900
PROGRAM_APPLICATION_WORKFLOW_ENABLED=True
# Private membership uploads: technical size limits, not document requirements.
MEMBERSHIP_FILE_MAX_MB=5
MEMBERSHIP_TOTAL_MAX_MB=20
MEMBERSHIP_SUBMISSION_LIMIT=20
MEMBERSHIP_SUBMISSION_WINDOW_SECONDS=3600
# Enable member-only assistance/referral tickets after setting the Association
# email in Admin > Assistance Information with Referral Support Inbox.
REFERRAL_ENABLED=True
# Connect Gmail in Community Assistance Desk > Association email settings to
# send directly; its encrypted credential takes precedence over this backend.
# Without a connected account, direct replies are blocked. Earlier local
# outbox messages remain historical and are not automatically resent.
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# For real delivery use django.core.mail.backends.smtp.EmailBackend and configure
# an authorized sender account locally. EMAIL_HOST_USER must match the address
# in Association email settings. Never commit its password.
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_TIMEOUT=10

# Publish Results prepares one personalized PDF certificate per selected member.
# Resend requires your own verified sending domain; gmail.com/resend.dev cannot
# send these certificates to arbitrary members. Keep this disabled until ready.
CERTIFICATE_RESEND_ENABLED=False
# Use gmail to reuse the saved Association Gmail connection without a domain.
CERTIFICATE_EMAIL_PROVIDER=gmail
RESEND_API_KEY=
RESEND_FROM_EMAIL=
CERTIFICATE_EMAIL_BACKGROUND=True
# Install LibreOffice on the application host. Leave blank to find soffice on PATH.
CERTIFICATE_OFFICE_EXECUTABLE=

# Shared, versioned household scoring configuration for new programs.
EWAF_VAULT_ENABLED=True
EWAF_DATASET_POLICY_ENABLED=True
EWAF_DATASET_SCORING_ENABLED=True

# Enable only after applying membership.0009 and validating the intended instance.
# Opens Association intake and the separate PDAO review/print queue.
ONLINE_MEMBERSHIP_ENABLED=True
# Non-secret snapshot of the owner's current development workflow. Review this
# policy before institutional deployment; it contains no members or credentials.
ASSOCIATION_REGISTRATION_POLICY_FILE=config/registration_policy.development.json
PDAO_ENFORCEMENT_ENABLED=False
# Enable after the short-reference migration has populated existing records.
SHORT_REFERENCES_ENABLED=False
